generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  emailVerified      DateTime?           @db.Timestamptz(3)
  image              String?
  role               Role                @default(USER)
  status             UserStatus          @default(ACTIVE)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  profile            UserProfile?
  sessions           Session[]
  posts              Post[]
  comments           Comment[]
  votes              PostVote[]
  reviews            BootReview[]
  reviewHelpfulVotes ReviewHelpfulVote[]
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  username    String   @unique @db.VarChar(30)
  displayName String   @db.VarChar(50)
  bio         String   @default("") @db.VarChar(300)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@index([expires])
}

// Shared across processes. Keys are HMACs, never plain email addresses.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

// Catalogue identities mirror the validated Phase 1 samples, not technical claims.
model BootBrand {
  id       String       @id
  name     String
  families BootFamily[]
}

model BootFamily {
  id          String           @id
  brandId     String
  name        String
  brand       BootBrand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  generations BootGeneration[]

  @@index([brandId])
}

model BootGeneration {
  id        String         @id
  familyId  String
  name      String
  family    BootFamily     @relation(fields: [familyId], references: [id], onDelete: Restrict)
  tiers     BootTier[]
  colorways BootColorway[]

  @@index([familyId])
}

model BootTier {
  id           String         @id
  generationId String
  name         String
  generation   BootGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  variants     BootVariant[]

  @@unique([id, generationId])
  @@index([generationId])
}

model BootVariant {
  id           String           @id
  tierModelId  String
  generationId String
  surface      String?          @db.VarChar(2)
  tier         BootTier         @relation(fields: [tierModelId, generationId], references: [id, generationId], onDelete: Restrict, onUpdate: Restrict)
  entries      CatalogueEntry[]
  reviews      BootReview[]

  @@unique([id, generationId])
  @@index([tierModelId])
}

model BootColorway {
  id           String           @id
  generationId String
  name         String
  swatch       String           @db.VarChar(7)
  generation   BootGeneration   @relation(fields: [generationId], references: [id], onDelete: Restrict)
  entries      CatalogueEntry[]

  @@unique([id, generationId])
  @@index([generationId])
}

model CatalogueEntry {
  id               String       @id
  slug             String       @unique
  outsoleVariantId String
  colorwayId       String
  generationId     String
  sample           Boolean      @default(true)
  variant          BootVariant  @relation(fields: [outsoleVariantId, generationId], references: [id, generationId], onDelete: Restrict, onUpdate: Restrict)
  colorway         BootColorway @relation(fields: [colorwayId, generationId], references: [id, generationId], onDelete: Restrict, onUpdate: Restrict)
  posts            Post[]

  @@unique([outsoleVariantId, colorwayId])
  @@index([colorwayId])
}

model PostCategory {
  id    String @id @db.VarChar(30)
  name  String @db.VarChar(50)
  posts Post[]
}

enum PostStatus {
  PUBLISHED
  HIDDEN
}

model Post {
  id           String          @id @default(cuid())
  slug         String          @unique @db.VarChar(120)
  title        String          @db.VarChar(160)
  content      String          @db.Text
  authorId     String
  categoryId   String
  bootEntryId  String?
  status       PostStatus      @default(PUBLISHED)
  version      Int             @default(1)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category     PostCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  boot         CatalogueEntry? @relation(fields: [bootEntryId], references: [id], onDelete: Restrict)
  tags         PostTag[]
  comments     Comment[]
  votes        PostVote[]
  score        Int             @default(0)
  commentCount Int             @default(0)

  @@index([status, createdAt, id])
  @@index([status, score, createdAt, id])
  @@index([status, commentCount, createdAt, id])
  @@index([authorId, status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([bootEntryId, status, createdAt])
}

model Tag {
  name  String    @id @db.VarChar(24)
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [name], onDelete: Restrict)

  @@id([postId, tagId])
  @@index([tagId])
}

model Comment {
  id              String    @id @default(cuid())
  postId          String
  authorId        String?
  parentCommentId String?
  parentDepth     Int?
  depth           Int       @default(0)
  content         String?   @db.Text
  version         Int       @default(1)
  deletedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author          User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent          Comment?  @relation("Replies", fields: [parentCommentId, postId, parentDepth], references: [id, postId, depth], onDelete: Restrict, onUpdate: Restrict)
  replies         Comment[] @relation("Replies")

  @@unique([id, postId, depth])
  @@index([postId, parentCommentId, createdAt, id])
  @@index([authorId])
}

model PostVote {
  postId    String
  userId    String
  value     Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

// One review per exact generation/tier/outsole variant; colorways share reviews.
model BootReview {
  id               String              @id @default(cuid())
  variantId        String
  authorId         String
  status           PostStatus          @default(PUBLISHED)
  version          Int                 @default(1)
  sizeWorn         String              @db.VarChar(12)
  sizeSystem       String              @db.VarChar(4)
  ownershipMonths  Int
  matchesPlayed    Int
  experience       String              @db.Text
  pros             String              @db.Text
  cons             String              @db.Text
  comfort          Int
  fit              Int
  traction         Int
  ballTouch        Int
  durability       Int
  value            Int
  ratingTotal      Int
  footLengthCm     Decimal?            @db.Decimal(4, 1)
  footWidthCm      Decimal?            @db.Decimal(4, 1)
  footShape        String?             @db.VarChar(20)
  shareFootInfo    Boolean             @default(false)
  position         String?             @db.VarChar(50)
  playingSurface   String?             @db.VarChar(4)
  widthObservation String?             @db.VarChar(30)
  toeRoom          String?             @db.VarChar(300)
  midfootPressure  String?             @db.VarChar(300)
  heelLockdown     String?             @db.VarChar(300)
  breakIn          String?             @db.VarChar(300)
  purchasePrice    Decimal?            @db.Decimal(10, 2)
  currency         String?             @db.VarChar(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  variant          BootVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  author           User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  helpfulVotes     ReviewHelpfulVote[]

  @@unique([authorId, variantId])
  @@index([variantId, status, createdAt, id])
  @@index([variantId, status, ratingTotal, createdAt, id])
  @@index([authorId, status, createdAt, id])
}

model ReviewHelpfulVote {
  reviewId  String
  userId    String
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  review    BootReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@index([userId])
}
