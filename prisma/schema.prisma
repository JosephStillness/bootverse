generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                    String                        @id @default(cuid())
  name                  String?
  email                 String                        @unique
  emailVerified         DateTime?                     @db.Timestamptz(3)
  image                 String?
  role                  Role                          @default(USER)
  status                UserStatus                    @default(ACTIVE)
  createdAt             DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                      @updatedAt @db.Timestamptz(3)
  footProfile           FootProfile?
  profile               UserProfile?
  sessions              Session[]
  posts                 Post[]
  comments              Comment[]
  votes                 PostVote[]
  reviews               BootReview[]
  reviewHelpfulVotes    ReviewHelpfulVote[]
  creator               CreatorProfile?
  images                UploadedImage[]
  reports               ContentReport[]
  moderationActions     ModerationAction[]
  verificationDecisions CreatorVerificationDecision[]
  videos                CreatorVideo[]
  checkedProductSources ProductSource[] @relation("SourceChecker")
  checkedProductClaims  ProductClaim[] @relation("ClaimReviewer")
  productImports ProductImportBatch[]
}

model UserProfile {
  id          String          @id @default(cuid())
  userId      String          @unique
  username    String          @unique @db.VarChar(30)
  displayName String          @db.VarChar(50)
  bio         String          @default("") @db.VarChar(300)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  images      UploadedImage[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@index([expires])
}

// Shared across processes. Keys are HMACs, never plain email addresses.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

// Catalogue identities mirror the validated Phase 1 samples, not technical claims.
model BootBrand {
  id       String       @id
  name     String
  families BootFamily[]
  slug String? @unique @db.VarChar(100)
  officialWebsite String? @db.VarChar(2000)
  status String @default("ACTIVE") @db.VarChar(10)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  sources ProductSource[]
  identifiers ProductIdentifier[]
}

model BootFamily {
  id          String           @id
  brandId     String
  name        String
  brand       BootBrand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  generations BootGeneration[]

  @@index([brandId])
}

model BootGeneration {
  id        String         @id
  familyId  String
  name      String
  family    BootFamily     @relation(fields: [familyId], references: [id], onDelete: Restrict)
  tiers     BootTier[]
  colorways BootColorway[]

  @@index([familyId])
}

model BootTier {
  id           String         @id
  generationId String
  name         String
  generation   BootGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)
  variants     BootVariant[]

  @@unique([id, generationId])
  @@index([generationId])
}

model BootVariant {
  id           String           @id
  tierModelId  String
  generationId String
  surface      String?          @db.VarChar(10)
  manufacturerOutsole String? @db.VarChar(120)
  constructionNote String? @db.VarChar(1000)
  tier         BootTier         @relation(fields: [tierModelId, generationId], references: [id, generationId], onDelete: Restrict, onUpdate: Restrict)
  entries      CatalogueEntry[]
  reviews      BootReview[]
  recommendationEvidence RecommendationEvidence[]
  claims ProductClaim[]

  @@unique([id, generationId])
  @@index([tierModelId])
}

model BootColorway {
  id           String           @id
  generationId String
  name         String
  swatch       String?          @db.VarChar(7)
  colorNames   String[]         @default([])
  generation   BootGeneration   @relation(fields: [generationId], references: [id], onDelete: Restrict)
  entries      CatalogueEntry[]

  @@unique([id, generationId])
  @@index([generationId])
}

model CatalogueEntry {
  id               String       @id
  slug             String       @unique
  outsoleVariantId String
  colorwayId       String
  generationId     String
  sample           Boolean      @default(true)
  published        Boolean      @default(false)
  specifications   Json         @default("{}")
  variant          BootVariant  @relation(fields: [outsoleVariantId, generationId], references: [id, generationId], onDelete: Restrict, onUpdate: Restrict)
  colorway         BootColorway @relation(fields: [colorwayId, generationId], references: [id, generationId], onDelete: Restrict, onUpdate: Restrict)
  posts            Post[]
  status ProductPublicationStatus @default(DRAFT)
  sourceId String?
  source ProductSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  slugLocked Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  identifiers ProductIdentifier[]
  claims ProductClaim[]
  productImages ProductImage[]
  productUploads UploadedImage[]
  offers RecommendationEvidence[]
  importRows ProductImportRow[]
  sourceRecords ProductSourceRecord[]

  @@unique([outsoleVariantId, colorwayId])
  @@unique([id, outsoleVariantId])
  @@index([colorwayId])
  @@index([published, id])
  @@index([status, createdAt, id])
  @@index([sourceId])
}

model PostCategory {
  id    String @id @db.VarChar(30)
  name  String @db.VarChar(50)
  posts Post[]
}

enum PostStatus {
  PUBLISHED
  HIDDEN
}

model Post {
  id           String          @id @default(cuid())
  slug         String          @unique @db.VarChar(120)
  title        String          @db.VarChar(160)
  content      String          @db.Text
  sponsorship  String?         @db.VarChar(120)
  authorId     String
  categoryId   String
  bootEntryId  String?
  status       PostStatus      @default(PUBLISHED)
  version      Int             @default(1)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category     PostCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  boot         CatalogueEntry? @relation(fields: [bootEntryId], references: [id], onDelete: Restrict)
  tags         PostTag[]
  comments     Comment[]
  votes        PostVote[]
  score        Int             @default(0)
  commentCount Int             @default(0)
  images       UploadedImage[]
  reports      ContentReport[]
  videos       CreatorVideo[]

  @@index([status, createdAt, id])
  @@index([status, score, createdAt, id])
  @@index([status, commentCount, createdAt, id])
  @@index([authorId, status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([bootEntryId, status, createdAt])
}

model Tag {
  name  String    @id @db.VarChar(24)
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [name], onDelete: Restrict)

  @@id([postId, tagId])
  @@index([tagId])
}

model Comment {
  id              String          @id @default(cuid())
  postId          String
  authorId        String?
  parentCommentId String?
  parentDepth     Int?
  depth           Int             @default(0)
  content         String?         @db.Text
  version         Int             @default(1)
  deletedAt       DateTime?       @db.Timestamptz(3)
  status          PostStatus      @default(PUBLISHED)
  reports         ContentReport[]
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  post            Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  author          User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent          Comment?        @relation("Replies", fields: [parentCommentId, postId, parentDepth], references: [id, postId, depth], onDelete: Restrict, onUpdate: Restrict)
  replies         Comment[]       @relation("Replies")

  @@unique([id, postId, depth])
  @@index([postId, parentCommentId, createdAt, id])
  @@index([authorId])
}

model PostVote {
  postId    String
  userId    String
  value     Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

// Colorways share reviews only when explicitly curated to the same construction variant.
model BootReview {
  id               String              @id @default(cuid())
  variantId        String
  authorId         String
  status           PostStatus          @default(PUBLISHED)
  version          Int                 @default(1)
  sizeWorn         String              @db.VarChar(12)
  sizeSystem       String              @db.VarChar(4)
  ownershipMonths  Int
  matchesPlayed    Int
  experience       String              @db.Text
  sponsorship      String?             @db.VarChar(120)
  pros             String              @db.Text
  cons             String              @db.Text
  comfort          Int
  fit              Int
  traction         Int
  ballTouch        Int
  durability       Int
  value            Int
  ratingTotal      Int
  footLengthCm     Decimal?            @db.Decimal(4, 1)
  footWidthCm      Decimal?            @db.Decimal(4, 1)
  footShape        String?             @db.VarChar(20)
  shareFootInfo    Boolean             @default(false)
  analysisConsent Boolean @default(false)
  analysisConsentAt DateTime? @db.Timestamptz(3)
  reviewInstep String? @db.VarChar(16)
  reviewFitSensation String? @db.VarChar(20)
  toeRoomCategory String? @db.VarChar(16)
  heelLockdownCategory String? @db.VarChar(16)
  breakInCategory String? @db.VarChar(24)
  position         String?             @db.VarChar(50)
  playingSurface   String?             @db.VarChar(4)
  widthObservation String?             @db.VarChar(30)
  toeRoom          String?             @db.VarChar(300)
  midfootPressure  String?             @db.VarChar(300)
  heelLockdown     String?             @db.VarChar(300)
  breakIn          String?             @db.VarChar(300)
  sizingAdvice     String?             @db.VarChar(300)
  purchasePrice    Decimal?            @db.Decimal(10, 2)
  currency         String?             @db.VarChar(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  variant          BootVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  author           User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  helpfulVotes     ReviewHelpfulVote[]
  images           UploadedImage[]
  reports          ContentReport[]
  videos           CreatorVideo[]

  @@unique([authorId, variantId])
  @@index([variantId, status, analysisConsent, id])
  @@index([variantId, status, createdAt, id])
  @@index([variantId, status, ratingTotal, createdAt, id])
  @@index([authorId, status, createdAt, id])
}

model ReviewHelpfulVote {
  reviewId  String
  userId    String
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  review    BootReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
  @@index([userId])
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

enum ImageState {
  UPLOADING
  READY
}

model CreatorProfile {
  id                 String                       @id @default(cuid())
  userId             String                       @unique
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  region             String?                      @db.VarChar(80)
  specialization     String                       @db.VarChar(80)
  youtube            String?                      @db.VarChar(500)
  tiktok             String?                      @db.VarChar(500)
  instagram          String?                      @db.VarChar(500)
  website            String?                      @db.VarChar(500)
  status             PostStatus                   @default(PUBLISHED)
  verificationStatus VerificationStatus           @default(UNVERIFIED)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(3)
  images             UploadedImage[]
  reports            ContentReport[]
  requests           CreatorVerificationRequest[]

  @@index([status, createdAt, id])
}

model UploadedImage {
  id        String          @id @default(cuid())
  ownerId   String
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  objectKey String          @unique
  slot      String          @db.VarChar(10)
  profileId String?
  profile   UserProfile?    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  creatorId String?
  creator   CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?           @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewId  String?
  review    BootReview?     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  productEntryId String?
  productEntry CatalogueEntry? @relation(fields: [productEntryId], references: [id], onDelete: Cascade)
  sha256 String? @db.VarChar(64)
  bytes     Int
  width     Int
  height    Int
  state     ImageState      @default(UPLOADING)
  status    PostStatus      @default(PUBLISHED)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  reports   ContentReport[]
  productImages ProductImage[]

  @@unique([productEntryId,sha256])
  @@index([productEntryId])
  @@index([state, createdAt])
  @@index([ownerId, createdAt])
  @@index([profileId])
  @@index([creatorId])
  @@index([postId])
  @@index([reviewId])
}

model StorageDeletion {
  objectKey String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

model ContentReport {
  id          String             @id @default(cuid())
  reporterId  String
  reporter    User               @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetKey   String             @db.VarChar(180)
  reason      String             @db.VarChar(30)
  explanation String?            @db.VarChar(1000)
  status      ReportStatus       @default(OPEN)
  postId      String?
  post        Post?              @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId   String?
  comment     Comment?           @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reviewId    String?
  review      BootReview?        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  imageId     String?
  image       UploadedImage?     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  creatorId   String?
  creator     CreatorProfile?    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  actions     ModerationAction[]

  @@unique([reporterId, targetKey])
  @@index([status, createdAt, id])
  @@index([postId])
  @@index([commentId])
  @@index([reviewId])
  @@index([imageId])
  @@index([creatorId])
}

model ModerationAction {
  id        String         @id @default(cuid())
  actorId   String?
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  reportId  String?
  report    ContentReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  targetKey String         @db.VarChar(180)
  action    String         @db.VarChar(20)
  note      String         @db.VarChar(1000)
  details   Json?
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  @@index([createdAt, id])
  @@index([reportId])
  @@index([actorId])
}

model CreatorVerificationRequest {
  id        String                        @id @default(cuid())
  creatorId String
  creator   CreatorProfile                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status    VerificationStatus            @default(PENDING)
  challenge String                        @unique @db.VarChar(80)
  youtube   String?                       @db.VarChar(500)
  tiktok    String?                       @db.VarChar(500)
  instagram String?                       @db.VarChar(500)
  createdAt DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                      @updatedAt @db.Timestamptz(3)
  decisions CreatorVerificationDecision[]

  @@index([status, createdAt, id])
  @@index([creatorId])
}

model CreatorVerificationDecision {
  id        String                     @id @default(cuid())
  requestId String
  request   CreatorVerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?                      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  status    VerificationStatus
  note      String                     @db.VarChar(1000)
  proofUrl  String?                    @db.VarChar(500)
  createdAt DateTime                   @default(now()) @db.Timestamptz(3)

  @@index([requestId, createdAt])
  @@index([actorId])
}

model CreatorVideo {
  id          String      @id @default(cuid())
  ownerId     String
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postId      String?
  post        Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewId    String?
  review      BootReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  videoId     String      @db.VarChar(11)
  title       String      @db.VarChar(120)
  sponsorship String?     @db.VarChar(120)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([postId, videoId])
  @@unique([reviewId, videoId])
  @@index([postId])
  @@index([reviewId])
  @@index([ownerId])
}

// Private current measurements. Historical BootReview measurements remain independent.
model FootProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leftLengthMm       Decimal? @db.Decimal(6, 2)
  rightLengthMm      Decimal? @db.Decimal(6, 2)
  leftWidthMm        Decimal? @db.Decimal(6, 2)
  rightWidthMm       Decimal? @db.Decimal(6, 2)
  measuredOn         DateTime? @db.Date
  measurementMethod  String?  @db.VarChar(200)
  footShape          String?  @db.VarChar(20)
  instep             String?  @db.VarChar(20)
  arch               String?  @db.VarChar(20)
  toePreference      String?  @db.VarChar(20)
  heelPreference     String?  @db.VarChar(20)
  snugness           String?  @db.VarChar(20)
  fitSensation       String?  @db.VarChar(20)
  primaryPosition    String?  @db.VarChar(10)
  secondaryPositions String[] @default([])
  surface            String?  @db.VarChar(2)
  budgetAmount       Decimal? @db.Decimal(9, 2)
  currency           String?  @db.VarChar(3)
  preferredBrands    String[] @default([])
  preferredTiers     String[] @default([])
  sizeWorn           Decimal? @db.Decimal(4, 2)
  sizeSystem         String?  @db.VarChar(4)
  allowFitFinder     Boolean  @default(false)
  fitFinderConsentAt DateTime? @db.Timestamptz(3)
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

// Operator-curated public product evidence. Never contains private user/profile data.
model RecommendationEvidence {
  id            String @id @default(cuid())
  variantId     String
  variant       BootVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  kind          String @db.VarChar(20)
  sourceKind    String @db.VarChar(20)
  sourceUrl     String @db.VarChar(2000)
  observedAt    DateTime @db.Timestamptz(3)
  validUntil    DateTime @db.Timestamptz(3)
  payload       Json
  approved      Boolean @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  sourceId String?
  source ProductSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  entryId String?
  entry CatalogueEntry? @relation(fields: [entryId, variantId], references: [id, outsoleVariantId], onDelete: Restrict, onUpdate: Restrict)
  countryCode String? @db.VarChar(2)
  importRowId String?
  importRow ProductImportRow? @relation(fields: [importRowId], references: [id], onDelete: SetNull)

  @@index([variantId, approved, observedAt])
  @@index([sourceId])
  @@index([entryId, countryCode, observedAt])
  @@index([importRowId])
}

enum ProductPublicationStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum ProductVerificationState {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  CONFLICTED
  REJECTED
}

enum ProductSourceType {
  MANUFACTURER
  RETAILER
  PRODUCT_FEED
  AFFILIATE_FEED
  MANUAL_RESEARCH
  COMMUNITY
  OTHER
}

model ProductSource {
  id String @id @default(cuid())
  name String @db.VarChar(120)
  type ProductSourceType
  baseUrl String @db.VarChar(2000)
  brandId String?
  brand BootBrand? @relation(fields: [brandId], references: [id], onDelete: Restrict)
  accessMethod String @db.VarChar(120)
  authorizationStatus String @default("UNKNOWN") @db.VarChar(20)
  permissionNotes String? @db.VarChar(1000)
  permissionUrl String? @db.VarChar(2000)
  usageRestrictions String? @db.VarChar(1000)
  status String @default("ACTIVE") @db.VarChar(10)
  checkedById String?
  checkedBy User? @relation("SourceChecker", fields: [checkedById], references: [id], onDelete: SetNull)
  authorizationCheckedAt DateTime? @db.Timestamptz(3)
  lastCheckedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  entries CatalogueEntry[]
  claims ProductClaim[]
  identifiers ProductIdentifier[]
  images ProductImage[]
  offers RecommendationEvidence[]
  imports ProductImportBatch[]
  sourceRecords ProductSourceRecord[]

  @@index([status, type, id])
  @@index([brandId])
  @@index([checkedById])
}

// Case-preserving manufacturer identifier; UNSPECIFIED is distinct from GLOBAL.
model ProductIdentifier {
  id String @id @default(cuid())
  entryId String
  entry CatalogueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  brandId String
  brand BootBrand @relation(fields: [brandId], references: [id], onDelete: Restrict)
  value String @db.VarChar(120)
  region String @default("UNSPECIFIED") @db.VarChar(11)
  sourceId String
  source ProductSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceUrl String @db.VarChar(2000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([brandId, region, value])
  @@index([entryId])
  @@index([sourceId])
}

model ProductClaim {
  id String @id @default(cuid())
  entryId String?
  entry CatalogueEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  variantId String?
  variant BootVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute String @db.VarChar(40)
  value Json
  basis String @db.VarChar(20)
  sourceId String
  source ProductSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceUrl String @db.VarChar(2000)
  observedAt DateTime @db.Timestamptz(3)
  status ProductVerificationState @default(UNVERIFIED)
  reviewerId String?
  reviewer User? @relation("ClaimReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt DateTime? @db.Timestamptz(3)
  reviewNote String? @db.VarChar(1000)
  notes String? @db.VarChar(1000)
  sourceRevision String? @db.VarChar(200)
  originalObservation Json?
  observationKey String? @unique @db.VarChar(64)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  importRowId String?
  importRow ProductImportRow? @relation(fields: [importRowId], references: [id], onDelete: SetNull)

  @@index([entryId, status, attribute])
  @@index([variantId, status, attribute])
  @@index([sourceId])
  @@index([reviewerId])
  @@index([importRowId])
}

// Reuse upload storage/deletion; external images are references, never fetched here.
model ProductImage {
  id String @id @default(cuid())
  entryId String
  entry CatalogueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  uploadedImageId String?
  uploadedImage UploadedImage? @relation(fields: [uploadedImageId], references: [id], onDelete: Cascade)
  externalUrl String? @db.VarChar(2000)
  assetKey String? @db.VarChar(64)
  sourceId String
  source ProductSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceUrl String @db.VarChar(2000)
  attribution String @db.VarChar(300)
  altText String @db.VarChar(300)
  licenseStatus String @default("UNKNOWN") @db.VarChar(10)
  permissionNotes String? @db.VarChar(1000)
  permissionUrl String? @db.VarChar(2000)
  sortOrder Int @default(0)
  isPrimary Boolean @default(false)
  status ProductVerificationState @default(UNVERIFIED)
  reviewedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  importRowId String?
  importRow ProductImportRow? @relation(fields: [importRowId], references: [id], onDelete: SetNull)

  @@unique([entryId,assetKey])
  @@index([entryId, status, sortOrder])
  @@index([uploadedImageId])
  @@index([sourceId])
  @@index([importRowId])
}

model ProductImportBatch {
 id String @id @default(cuid())
 sourceId String
 source ProductSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
 actorId String?
 actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
 purpose String @default("IMPORT") @db.VarChar(12)
 format String @db.VarChar(10)
 checksum String @db.VarChar(64)
 idempotencyKey String @db.VarChar(100)
 status String @default("RUNNING") @db.VarChar(12)
 summary Json @default("{}")
 sourceSnapshot Json @default("{}")
 errorCode String? @db.VarChar(64)
 startedAt DateTime @default(now()) @db.Timestamptz(3)
 completedAt DateTime? @db.Timestamptz(3)
 rows ProductImportRow[]
 sourceRecords ProductSourceRecord[]

 @@unique([sourceId,idempotencyKey])
 @@unique([sourceId,id])
 @@index([purpose,startedAt,id])
 @@index([startedAt,id])
 @@index([actorId])
}

model ProductSourceRecord {
 id String @id @default(cuid())
 sourceId String
 source ProductSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
 recordId String @db.VarChar(120)
 entryId String?
 entry CatalogueEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
 checksum String @db.VarChar(64)
 identityHash String @db.VarChar(64)
 sourceUrl String @db.VarChar(2000)
 observedAt DateTime @db.Timestamptz(3)
 lastBatchId String
 lastBatch ProductImportBatch @relation(fields: [sourceId,lastBatchId], references: [sourceId,id], onDelete: Restrict)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)

 @@unique([sourceId,recordId])
 @@index([entryId])
 @@index([lastBatchId])
}

model ProductImportRow {
 id String @id @default(cuid())
 batchId String
 batch ProductImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
 rowNumber Int
 recordId String? @db.VarChar(120)
 entryId String?
 entry CatalogueEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
 outcome String @db.VarChar(24)
 action String @db.VarChar(16)
 checksum String? @db.VarChar(64)
 sourceUrl String? @db.VarChar(2000)
 observedAt DateTime? @db.Timestamptz(3)
 verificationStatus ProductVerificationState @default(UNVERIFIED)
 data Json?
 diagnostics Json @default("[]")
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 claims ProductClaim[]
 images ProductImage[]
 offers RecommendationEvidence[]

 @@unique([batchId,rowNumber])
 @@index([entryId])
 @@index([batchId,outcome,rowNumber])
}
