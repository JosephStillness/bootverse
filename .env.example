# PostgreSQL: create a dedicated empty database, then npm run db:deploy.
DATABASE_URL=postgresql://bootverse:change-me@127.0.0.1:5432/bootverse
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Fixed public origin; production must use HTTPS. Do not derive it from requests.
AUTH_URL=http://localhost:3000
# SMTP URL and sender. For local email testing see docs/phase-2-foundation.md.
EMAIL_SERVER=smtp://127.0.0.1:1025
EMAIL_FROM=BootVerse <noreply@bootverse.local>
