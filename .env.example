# PostgreSQL: create a dedicated empty database, then npm run db:deploy.
DATABASE_URL=postgresql://bootverse:change-me@127.0.0.1:5432/bootverse
# Optional direct, non-pooled Neon URL for Prisma migrations (app keeps DATABASE_URL).
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_NEON_HOST/neondb?sslmode=verify-full
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Fixed public origin; production must use HTTPS. Do not derive it from requests.
AUTH_URL=http://localhost:3000
# SMTP URL and sender. For local email testing see docs/phase-2-foundation.md.
EMAIL_SERVER=smtp://127.0.0.1:1025
EMAIL_FROM=BootVerse <noreply@bootverse.local>
# Optional: x-real-ip or cf-connecting-ip, only behind a trusted proxy which
# overwrites this header and blocks direct app access. Leave unset for local dev.
AUTH_TRUSTED_IP_HEADER=

# Sprint 2.5: private S3-compatible storage. npm run dev:storage creates ignored local credentials.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_PER_CONTENT=4
UPLOAD_MAX_PER_USER=100
UPLOAD_USER_QUOTA_BYTES=104857600
# Schedule npm run storage:cleanup periodically; failed storage deletions remain queued.
# Omit both custom S3 keys to use the AWS SDK default credential chain / task role.
# Optional only when using temporary explicit S3 credentials:
S3_SESSION_TOKEN=
# Read-only liveness/readiness: /api/health/live and /api/health/ready.
# Successful Finder request timing is opt-in; logs never contain private inputs.
BOOT_FIT_TIMING_LOGS=0

# Product import/enrichment: local-only until separately approved for remote use.
# Import bounds: bytes 1024..20971520, rows 1..5000; enrichment additionally caps at 1000.
PRODUCT_IMPORT_MAX_BYTES=10485760
PRODUCT_IMPORT_MAX_ROWS=5000
# Potential staleness thresholds (days); old evidence is not automatically false.
PRODUCT_FRESHNESS_PRICE_DAYS=7
PRODUCT_FRESHNESS_STOCK_DAYS=1
PRODUCT_FRESHNESS_LISTING_DAYS=90
PRODUCT_FRESHNESS_TECHNICAL_DAYS=730
PRODUCT_FRESHNESS_SOURCE_DAYS=90

# D5 source synchronization (all optional; sync is disabled per source by default).
# Synthetic fixture adapters: local testing only. Never enable in shared environments.
SYNC_FIXTURES_ENABLED=0
# SYNC_FIXTURE_DIR=fixtures/sync
# Live HTTPS feeds: only after written permission is recorded in the source registry.
# SYNC_HTTP_FEEDS=example-feed
# SYNC_FEED_EXAMPLE_FEED_URL=https://feeds.provider.example/v1/products
# SYNC_FEED_EXAMPLE_FEED_TOKEN=          # secret: inject at runtime, never commit
# SYNC_FEED_EXAMPLE_FEED_MODE=SNAPSHOT   # SNAPSHOT (complete) or DELTA (partial)
# SYNC_ALLOWED_HOSTS=feeds.provider.example
# Signed internal scheduler endpoint (disabled when unset; >=32 random characters).
# SYNC_SCHEDULER_SECRET=
SYNC_PRICE_FRESH_HOURS=24
SYNC_STOCK_FRESH_HOURS=12
SYNC_PRICE_EVIDENCE_HOURS=48
SYNC_PRICE_REFRESH_HOURS=24
SYNC_AUTHORIZATION_REVIEW_DAYS=180
SYNC_STALE_FEED_MULTIPLIER=3
SYNC_LEASE_MINUTES=15
SYNC_LONG_RUNNING_MINUTES=30
SYNC_BACKOFF_BASE_MINUTES=5
SYNC_BACKOFF_MAX_HOURS=24
SYNC_FAILING_AFTER=3
SYNC_MAX_REJECT_RATE=0.5
SYNC_PAYLOAD_RETENTION_DAYS=30
# SYNC_SEVERITY_OVERRIDES={"SPEC_CORROBORATION":"MATERIAL"}   # may raise, never lower, review requirements
