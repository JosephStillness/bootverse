# PLACEHOLDERS ONLY. Install a real file outside the checkout, mode 0600.
# Do not source this file as shell code. Compose reads it as an env file.
DATABASE_URL=postgresql://STAGING_APP_USER:REPLACE_ME@STAGING_ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# CLI/maintenance only; omit this key from the web container's real env file.
# Prisma 7 reads DATABASE_URL_UNPOOLED, NOT DIRECT_URL.
# DATABASE_URL_UNPOOLED=postgresql://STAGING_MIGRATOR:REPLACE_ME@STAGING_ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full
AUTH_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_URL=https://staging.bootverse.example.com
# Auth.js trustHost is set in existing code; fixed AUTH_URL and proxy validation are mandatory.
# No separate NEXT_PUBLIC_APP_URL or AUTH_TRUST_HOST is read by this app.
EMAIL_SERVER=smtps://resend:REPLACE_WITH_URL_ENCODED_STAGING_RESEND_KEY@smtp.resend.com:465
EMAIL_FROM=BootVerse Staging <signin@staging-mail.example.com>
AUTH_TRUSTED_IP_HEADER=x-real-ip
S3_BUCKET=REPLACE_WITH_PRIVATE_STAGING_BUCKET
S3_REGION=ap-southeast-2
# Omit S3_ENDPOINT for AWS S3. Never inject local RustFS endpoints into staging.
# Lightsail: approved restricted, rotated keys supplied privately at runtime.
# ECS: omit BOTH keys and token to use the task role credential chain instead.
S3_ACCESS_KEY_ID=REPLACE_WITH_APPROVED_STAGING_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_APPROVED_STAGING_SECRET
# S3_SESSION_TOKEN=REPLACE_ONLY_IF_USING_TEMPORARY_EXPLICIT_CREDENTIALS
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_PER_CONTENT=4
UPLOAD_MAX_PER_USER=100
UPLOAD_USER_QUOTA_BYTES=104857600
BOOT_FIT_TIMING_LOGS=0
NEXT_TELEMETRY_DISABLED=1
